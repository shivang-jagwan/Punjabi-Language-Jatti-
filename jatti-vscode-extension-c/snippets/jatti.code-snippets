      "chal_oye ${1:name} ban ${2:value}"
    ],
    "description": "Variable assignment"
  },
  "If": {
    "prefix": "if",
    "body": [
      "je ${1:condition}",
      "    $0"
    ],
    "description": "If block"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": [
      "je ${1:condition}",
