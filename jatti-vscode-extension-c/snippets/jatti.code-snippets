{
  "Program Skeleton": {
    "prefix": "main",
    "body": [
      "sun_we",
      "    $0",
      "ja_we"
    ],
    "description": "Jatti program skeleton"
  },
  "Print": {
    "prefix": "chilla",
    "body": [
      "chilla_we ${1:\"text\"}"
    ],
    "description": "Print expression"
  },
  "Assignment": {
    "prefix": "set",
