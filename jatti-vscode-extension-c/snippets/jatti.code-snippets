    ],
    "description": "Function definition"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "chal_koshish_karle",
      "    $1",
      "pakad ${2:err}",
      "    $0"
    ],
    "description": "Try-catch block"
  },
  "List": {
    "prefix": "list",
    "body": [
      "[${1:1}, ${2:2}, ${3:3}]"
    ],
    "description": "List literal"
  },
  "Dictionary": {
    "prefix": "dict",
    "body": [
      "{\"${1:key}\": ${2:value}}"
    ],
    "description": "Dictionary literal"
  }
